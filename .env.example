# ══════════════════════════════════════════════════════════════
# 复制成 .env 再填自己的值。  cp .env.example .env
#
# 这个文件可以被两种方式读取：
#   1) 直接跑 ./feishu_bot.py —— 程序会自动读同目录下的 .env
#   2) 用 systemd —— 直接把下面的值填进 systemd/feishu_bot.service
#      （systemd 的环境变量优先，不会被 .env 覆盖）
# ══════════════════════════════════════════════════════════════

# ── 必填：飞书自建应用凭据 ────────────────────────────────────
# 开放平台 → 你的应用 → 「凭证与基础信息」
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 选填：事件订阅的加密与校验 ────────────────────────────────
# 开放平台 → 「事件与回调」。用长连接模式时留空也能跑。
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# ── 选填：DSH 安装位置（不填会自动探测 ~/software/deepseek_harness_agent）──
# DSH_APP_DIR=/home/you/software/deepseek_harness_agent
# DSH_HOME=/home/you/software/deepseek_harness_agent/user_data

# ── 选填：数据目录 ────────────────────────────────────────────
# 不填 = 程序和运行数据放一起（bot 目录内）。
# 想「代码与数据分离」（推荐，开源仓库尤其如此），指到别处即可：
# FB_DATA_DIR=/home/you/.feishu-bot-data

# ── 选填：调优 ────────────────────────────────────────────────
# 图片合并窗口（秒）。收到「纯图片」先攥住这么久，等用户接着打的那句话，
# 图文合成一轮再回；窗口内没等到文字才单独处理。设 0 关闭合并。
# FB_IMAGE_MERGE_SEC=8

# 归档/恢复的待定状态有效期（秒）。发「归档会话」/「查看归档」后，
# 下一个数字在这个时间内才算目标。
# FB_ARCHIVE_TTL_SEC=180

# 设为 1 可关掉「自动隐藏 Bot 自己产生的 GUI 会话」这个行为
# FB_HIDE_HEADLESS=0

# ── 选填：工具链（只影响 DSH 能否编译安卓项目）────────────────
# JDK17_HOME=/home/you/software/openjdk17.0.20_8
# ANDROID_HOME=/home/you/software/Android_Sdk
